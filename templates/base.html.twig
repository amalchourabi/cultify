        .header-area {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000; /* Assurez-vous que le header est au-dessus du contenu */
            background-color: white; /* Ajoutez une couleur de fond si nécessaire */
        }

