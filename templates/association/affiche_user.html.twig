{% extends 'base.html.twig' %}

{% block css %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Vos styles personnalisés ici */
        .card {
          position: relative;
          width: 300px;
          height: 200px;
          background: linear-gradient(-45deg, #f89b29 0%, #ff0f7b 100% );
          border-radius: 10px;
          display: flex;
          align-items: center;
          justify-content: center;
          overflow: hidden;
          transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
        }

        .card-image {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
          z-index: 1;
        }

        .card svg {
          width: 48px;
          fill: #333;
          transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
        }

        .card:hover {
          transform: rotate(-5deg) scale(1.1);
          box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

        .card__content {
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%) rotate(-45deg);
          width: 100%;
          height: 100%;
          padding: 20px;
          box-sizing: border-box;
          background-color: #fff;
          opacity: 0;
          transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
          z-index: 2;
        }

        .card:hover .card__content {
          transform: translate(-50%, -50%) rotate(0deg);
          opacity: 1;
        }

        .card__title {
          margin: 0;
          font-size: 24px;
          color: #333;
          font-weight: 700;
        }

        .card__description {
          margin: 10px 0 0;
          font-size: 14px;
          color: #777;
          line-height: 1.4;
        }

        .card:hover svg {
          scale: 0;
          transform: rotate(-45deg);
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3">Liste des associations ({{ associations|length }})</h1>
                {% if user.role == 'organisateur' %}
                    <div class="alert alert-info">
                        <strong>Montant à payer :</strong> {{ user.montantAPayer }} TDN
                        <br>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Barre de recherche #}
    <div class="row mb-4">
        <div class="col">
            <input type="text" id="searchInput" class="form-control" placeholder="Rechercher une association...">
        </div>
    </div>

    {# Conteneur pour les résultats #}
    <div class="row" id="associationsContainer">
        {% for association in associations %}
        <div class="col-md-4 mb-4">
            <div class="card">
                {% if association.image %}
                    <div class="card-image" style="background-image: url('{{ asset('uploads/images/' ~ association.image) }}');"></div>
                {% else %}
                    <div class="card-image">
                        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                            <path d="M20 5H4V19L13.2923 9.70649C13.6828 9.31595 14.3159 9.31591 14.7065 9.70641L20 15.0104V5ZM2 3.9934C2 3.44476 2.45531 3 2.9918 3H21.0082C21.556 3 22 3.44495 22 3.9934V20.0066C22 20.5552 21.5447 21 21.0082 21H2.9918C2.44405 21 2 20.5551 2 20.0066V3.9934ZM8 11C6.89543 11 6 10.1046 6 9C6 7.89543 6.89543 7 8 7C9.10457 7 10 7.89543 10 9C10 10.1046 9.10457 11 8 11Z"></path>
                        </svg>
                    </div>
                {% endif %}
                <div class="card__content">
                    <p class="card__title">{{ association.nom|upper }}</p>
                    <p class="card__description">
                        <strong>Description :</strong> {{ association.description }}<br>
                        <strong>Contact :</strong> {{ association.contact }}<br>
                        <strong>But :</strong> {{ association.but }}<br>
                        <strong>Objectif :</strong> {{ association.montantDesire|number_format(2, ',', ' ') }} TND<br>
                    </p>
                    <div class="progress mb-2" style="height: 20px;">
                        <div class="progress-bar" 
                             role="progressbar" 
                             style="width: {{ association.pourcentageProgression }}%;" 
                             aria-valuenow="{{ association.pourcentageProgression }}" 
                             aria-valuemin="0" 
                             aria-valuemax="100">
                            {{ association.pourcentageProgression|number_format(1) }}%
                        </div>
                    </div>
                    <a href="{{ path('app_don_new', {'id': association.id}) }}" class="btn btn-primary">Faire un don</a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('searchInput').addEventListener('input', function () {
    const searchTerm = this.value;
    fetch(`/associations/search?search=${encodeURIComponent(searchTerm)}`)
        .then(response => response.json())
        .then(data => {
            const container = document.getElementById('associationsContainer');
            container.innerHTML = ''; // Effacer les résultats précédents

            data.forEach(association => {
                const card = `
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            ${association.image ?
                                `<div class="card-image" style="background-image: url('{{ asset('uploads/images/') }}${association.image}');"></div>` :
                                `<div class="card-image">
                                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M20 5H4V19L13.2923 9.70649C13.6828 9.31595 14.3159 9.31591 14.7065 9.70641L20 15.0104V5ZM2 3.9934C2 3.44476 2.45531 3 2.9918 3H21.0082C21.556 3 22 3.44495 22 3.9934V20.0066C22 20.5552 21.5447 21 21.0082 21H2.9918C2.44405 21 2 20.5551 2 20.0066V3.9934ZM8 11C6.89543 11 6 10.1046 6 9C6 7.89543 6.89543 7 8 7C9.10457 7 10 7.89543 10 9C10 10.1046 9.10457 11 8 11Z"></path>
                                    </svg>
                                </div>`
                            }
                            <div class="card__content">
                                <p class="card__title">${association.nom.toUpperCase()}</p>
                                <p class="card__description">
                                    <strong>Description :</strong> ${association.description}<br>
                                    <strong>Contact :</strong> ${association.contact}<br>
                                    <strong>But :</strong> ${association.but}<br>
                                    <strong>Objectif :</strong> ${association.montantDesire ?? 'N/A'} TND<br>
                                </p>
                                <div class="progress mb-2" style="height: 20px;">
                                    <div class="progress-bar" 
                                         role="progressbar" 
                                         style="width: ${association.pourcentageProgression ?? 0}%;" 
                                         aria-valuenow="${association.pourcentageProgression ?? 0}" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                        ${association.pourcentageProgression?.toFixed(1) ?? 0}%
                                    </div>
                                </div>
                                <a href="{{ path('app_don_new', {'id': '${association.id}'}) }}" class="btn btn-primary">Faire un don</a>
                            </div>
                        </div>
                    </div>
                `;
                container.innerHTML += card;
            });
        })
        .catch(error => console.error('Erreur lors de la recherche :', error));
});
    </script>
{% endblock %}