{% extends 'base.html.twig' %}

{% block body %}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3">Liste des associations ({{ associations|length }})</h1>
                <button class="btn btn-primary" type="button" data-bs-toggle="collapse" onclick="window.location.href='{{ path('app_association_add') }}'">
                    Ajouter une association
                </button>
            </div>
        </div>
    </div>

    {# Barre de recherche #}
    <div class="row mb-4">
        <div class="col">
            <input type="text" id="searchInput" class="form-control" placeholder="Rechercher une association...">
        </div>
    </div>

    {# Tableau des associations #}
    <div class="card mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover" id="associationsTable">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Description</th>
                            <th>Contact</th>
                            <th>But</th>
                            <th>Montant desire</th>
                            <th>Site web</th>
                            <th>Image</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for association in associations %}
                        <tr>
                            <td>{{ association.id }}</td>
                            <td>{{ association.nom|upper }}</td>
                            <td>{{ association.description }}</td>
                            <td>{{ association.contact }}</td>
                            <td>{{ association.but }}</td>
                            <td>{{ association.montantDesire }}</td>
                            <td>
                                {% if association.siteWeb %}
                                    <a href="{{ association.siteWeb }}" target="_blank">{{ association.siteWeb }}</a>
                                {% else %}
                                    Aucun site web
                                {% endif %}
                            </td>
                            <td>
                                {% if association.image %}
                                    <img src="{{ asset('uploads/images/' ~ association.image) }}" alt="{{ association.nom }}" width="200">
                                {% else %}
                                    Aucune image disponible
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    <a href="{{ path('app_association_edit', {'id': association.id }) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                    <a href="{{ path('app_association_delete', {'id': association.id }) }}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette association ?')">
                                        <i class="bi bi-trash"></i> Supprimer
                                    </a>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('searchInput').addEventListener('input', function () {
            const searchTerm = this.value;
            fetch(`/associations/search?search=${encodeURIComponent(searchTerm)}`)
                .then(response => response.json())
                .then(data => {
                    const tableBody = document.querySelector('#associationsTable tbody');
                    tableBody.innerHTML = ''; // Effacer les résultats précédents

                    data.forEach(association => {
                        const row = `
                            <tr>
                                <td>${association.id}</td>
                                <td>${association.nom.toUpperCase()}</td>
                                <td>${association.description}</td>
                                <td>${association.contact}</td>
                                <td>${association.but}</td>
                                <td>${association.montantDesire}</td>
                                <td>
                                    ${association.siteWeb ? `<a href="${association.siteWeb}" target="_blank">${association.siteWeb}</a>` : 'Aucun site web'}
                                </td>
                                <td>
                                    ${association.image ? `<img src="/uploads/images/${association.image}" alt="${association.nom}" width="200">` : 'Aucune image disponible'}
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a href="/association/edit/${association.id}" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i> Modifier
                                        </a>
                                        <a href="/association/delete/${association.id}" class="btn btn-sm btn-outline-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette association ?')">
                                            <i class="bi bi-trash"></i> Supprimer
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        `;
                        tableBody.innerHTML += row;
                    });
                })
                .catch(error => console.error('Erreur lors de la recherche :', error));
        });
    </script>
{% endblock %}