{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }} {# Conserve les styles de base.html.twig #}
    <style>
        .form-container {
            background-color: #f8f9fa; /* Couleur de fond */
            padding: 20px;
            border-radius: 10px; /* Bordures arrondies */
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Ombre légère */
            margin-top: 50px; /* Espacement en haut */
        }

        .form-group {
            margin-bottom: 1.5rem; /* Espacement entre les champs */
        }

        .btn-primary {
            padding: 10px; /* Espacement interne */
            font-size: 16px; /* Taille de police */
            width: auto; /* Largeur automatique pour le bouton */
            display: block; /* Pour centrer le bouton */
            margin: 0 auto; /* Centrer horizontalement */
        }

        .form-label {
            font-weight: bold; /* Texte en gras pour les labels */
        }

        h1 {
            text-align: center; /* Centrer le titre */
            margin-bottom: 30px; /* Espacement en bas du titre */
        }
    </style>
{% endblock %}

{% block body %}
<div class="container">
    <div class="row justify-content-center"> {# Centrer horizontalement #}
        <div class="col-md-6"> {# Limiter la largeur du formulaire #}
            <div class="form-container">
                <h1>Modifier le don</h1>
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="form-group row">
                        {{ form_label(form.montant, 'Montant', {'label_attr': {'class': 'col-sm-4 col-form-label form-label'}}) }}
                        <div class="col-sm-8">
                            {{ form_widget(form.montant, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.montant) }} {# Affiche les messages d'erreur pour le montant #}
                        </div>
                    </div>

                    <div class="form-group row">
                        {{ form_label(form.association, 'Association', {'label_attr': {'class': 'col-sm-4 col-form-label form-label'}}) }}
                        <div class="col-sm-8">
                            {{ form_widget(form.association, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.association) }} {# Affiche les messages d'erreur pour l'association #}
                        </div>
                    </div>

                    <div class="form-group row">
        <div class="col-sm-12">
            {{ form_widget(form.captcha) }}
        </div>
    </div>

                    <div class="form-group row">
                        <div class="col-sm-12 text-center"> {# Centrer le bouton #}
                            <button type="submit" class="btn btn-primary">Soumettre</button>
                        </div>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}