{% extends 'base.html.twig' %}

{% block title %}Créer une nouvelle réservation{% endblock %}

{% block body %}
    <h1>Créer une nouvelle réservation</h1>

    {{ form_start(form, {'method': 'POST', 'attr': {'novalidate': 'novalidate'}})}}
        {{ form_widget(form) }}
        <button class="btn">{{ button_label|default('Save') }}</button>
    {{ form_end(form) }}

    <a href="{{ path('app_reservation_index') }}">Retour à la liste des réservations</a>
{% endblock %}
