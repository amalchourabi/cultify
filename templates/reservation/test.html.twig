{% extends 'base.html.twig' %}

{% block title %}Test FindAll Reservations{% endblock %}

{% block body %}
    <h1>Liste des Réservations</h1>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>État</th>
                <th>Date</th>
                <th>Thème</th>
                <th>URL</th>
                <th>Nombre de Tickets</th>
            </tr>
        </thead>
        <tbody>
        {% for reservation in reservations %}
            <tr>
                <td>{{ reservation.getIdR }}</td>
                <td>{{ reservation.getEtat }}</td>
                <td>{{ reservation.getDateR ? reservation.getDateR|date('Y-m-d') : 'N/A' }}</td>
                <td>{{ reservation.getTheme }}</td>
                <td>{{ reservation.getUrl }}</td>
                <td>{{ reservation.getNbTickets }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucune réservation trouvée</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}