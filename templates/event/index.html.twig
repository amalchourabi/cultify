{% extends 'base.html.twig' %}

{% block title %}Event index{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="text-center mb-4">Liste des Événements</h1>

        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-striped table-hover">
                    <thead class="thead-dark">
                        <tr>
                            <th>ID</th>
                            <th>Titre</th>
                            <th>Description</th>
                            <th>Lieu</th>
                            <th>Date</th>
                            <th>Organisation</th>
                            <th>Capacité</th>
                            <th>Places Dispo</th>
                            <th>Catégorie</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for event in events %}
                        <tr>
                            <td>{{ event.getIdE() }}</td>
                            <td>{{ event.getTitre() }}</td>
                            <td>{{ event.getDescription() }}</td>
                            <td>{{ event.getLieu() }}</td>
                            <td>{{ event.getDateE() ? event.getDateE()|date('Y-m-d') : '' }}</td>
                            <td>{{ event.getOrganisation() }}</td>
                            <td>{{ event.getCapacite() }}</td>
                            <td>{{ event.getNbplaces() }}</td>
                            <td>{{ event.getCategorie() }}</td>
                            <td>
                                <a href="{{ path('app_event_show', {'id_e': event.getIdE()}) }}" class="btn btn-info btn-sm">Voir</a>
                                <a href="{{ path('app_event_edit', {'id_e': event.getIdE()}) }}" class="btn btn-warning btn-sm">Modifier</a>
                                <a href="{{ path('app_reservation_new', {'id_e': event.getIdE()}) }}" class="btn btn-primary btn-sm">Réserver</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="10" class="text-center text-muted">Aucun événement trouvé</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
