{% extends 'base.html.twig' %}

{% block title %}Event{% endblock %}

{% block body %}
    <h1>Event</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id_e</th>
                <td>{{ event.getIdE }}</td>
            </tr>
            <tr>
                <th>Titre</th>
                <td>{{ event.getTitre }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ event.getDescription }}</td>
            </tr>
            <tr>
                <th>Lieu</th>
                <td>{{ event.getLieu}}</td>
            </tr>
            <tr>
                <th>Date_e</th>
                <td>{{ event.getDateE ? event.getDateE|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Organisation</th>
                <td>{{ event.getOrganisation }}</td>
            </tr>
            <tr>
                <th>Capacite</th>
                <td>{{ event.getCapacite }}</td>
            </tr>
            <tr>
                <th>Nbplaces</th>
                <td>{{ event.getNbplaces }}</td>
            </tr>
            <tr>
                <th>Categorie</th>
                <td>{{ event.getCategorie }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_event_index') }}">back to list</a>

    <a href="{{ path('app_event_edit', {'id_e': event.getIdE}) }}">edit</a>
<a href="{{ path('app_reservation_new', { id_e: event.idE }) }}" class="btn btn-primary">
    Ajouter une réservation
</a>

    {{ include('event/_delete_form.html.twig') }}
{% endblock %}
