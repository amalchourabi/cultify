<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <title>{% block title %}Admin Encyclopédie{% endblock %}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    
    <!-- Styles -->
    <link href="{{ asset('https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css') }}" rel="stylesheet">
    <link href="{{ asset('backoffice/lib/owlcarousel/assets/owl.carousel.min.css') }}" rel="stylesheet">
    <link href="{{ asset('backoffice/lib/tempusdominus/css/tempusdominus-bootstrap-4.min.css') }}" rel="stylesheet">
    <link href="{{ asset('backoffice/css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('backoffice/css/style.css') }}" rel="stylesheet">
    
    {% block stylesheets %}{% endblock %}
</head>

<body>
    <div class="container-xxl position-relative bg-white d-flex p-0">
        <!-- Sidebar -->
        <div class="sidebar pe-4 pb-3">
            <nav class="navbar bg-light navbar-light">
                <a href="{{ path('app_admin_dashboard') }}" class="navbar-brand mx-4 mb-3">
                    <h3 class="text-primary"><i class="fa fa-hashtag me-2"></i>Encyclopédie</h3>
                </a>
                <div class="navbar-nav w-100">
                    <a href="{{ path('app_contenu_multi_media_list') }}" class="nav-item nav-link active">
                        <i class="fa fa-table me-2"></i>Contenus Multimedia
                    </a>
                    <a href="{{ path('app_quiz_list') }}" class="nav-item nav-link">
                        <i class="fa fa-question-circle me-2"></i>Quiz
                    </a>
                          <a href="{{ path('app_question_list') }}" class="nav-item nav-link">
                        <i class="fa fa-question-circle me-2"></i>Question
                    </a>
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="fa fa-plus-circle me-2"></i>Ajouter
                        </a>
                        <div class="dropdown-menu bg-transparent border-0">
                            <a href="{{ path('app_contenu_multi_media_new') }}" class="dropdown-item">Nouveau Contenu</a>
                            <a href="{{ path('app_quiz_new') }}" class="dropdown-item">Nouveau Quiz</a>
                            <a href="{{ path('app_question_new') }}" class="dropdown-item">Nouveau Question</a>
                        </div>
                    </div>
                </div>
            </nav>
        </div>

        <!-- Content -->
        <div class="content">
            <!-- Navbar -->
            <nav class="navbar navbar-expand bg-light navbar-light sticky-top px-4 py-0">
                <!-- ... (garder la navbar existante) ... -->
            </nav>

            <!-- Block principal -->
            <div class="container-fluid pt-4 px-4">
                {% block body %}{% endblock %}
            </div>

            <!-- Footer -->
            <div class="container-fluid pt-4 px-4">
                <div class="bg-light rounded-top p-4">
                    <!-- ... (footer existant) ... -->
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="{{ asset('backoffice/lib/chart/chart.min.js') }}"></script>
    <script src="{{ asset('backoffice/lib/easing/easing.min.js') }}"></script>
    <script src="{{ asset('backoffice/lib/waypoints/waypoints.min.js') }}"></script>
    <script src="{{ asset('backoffice/lib/owlcarousel/owl.carousel.min.js') }}"></script>
    <script src="{{ asset('backoffice/lib/tempusdominus/js/moment.min.js') }}"></script>
    <script src="{{ asset('backoffice/lib/tempusdominus/js/tempusdominus-bootstrap-4.min.js') }}"></script>
    
    {% block javascripts %}{% endblock %}
</body>
</html>