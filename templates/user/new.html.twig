{# templates/user/new.html.twig #}

{% extends 'base.html.twig' %}

{% block title %}Create New User{% endblock %}

{% block body %}
    <h1>Create New User</h1>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        {{ form_row(form.nom) }}
        {{ form_row(form.prenom) }}
        {{ form_row(form.username) }}
        {{ form_row(form.num_tel) }}
        {{ form_row(form.email) }}
        {{ form_row(form.gender) }}
        {{ form_row(form.password) }}
        {{ form_row(form.roles) }}
        {{ form_row(form.MontantApayer) }}
        <div class="form-group">
        {{ form_label(form.Datedenaissance, 'Date of Birth') }}
        {{ form_widget(form.Datedenaissance, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.Datedenaissance) }}
    </div>
        <button type="submit" class="btn btn-primary">Create</button>
    {{ form_end(form) }}

    <a href="{{ path('app_user_index') }}">Back to List</a>
{% endblock %}