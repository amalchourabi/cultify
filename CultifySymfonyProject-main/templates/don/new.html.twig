{% extends 'basefront.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .form-container {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .btn-primary {
            padding: 10px;
            font-size: 16px;
            width: auto;
            display: block;
            margin: 0 auto;
        }
        
        .form-label {
            font-weight: bold;
        }
        
        h1 {
            text-align: center;
            margin-bottom: 30px;
        }
    </style>
{% endblock %}

{% block body %}
<!-- Espacement direct avec attributs HTML -->
<br style="line-height: 50px;">
<br style="line-height: 50px;">
<br style="line-height: 50px;">
<br style="line-height: 50px;">
<br style="line-height: 50px;">

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="form-container">
                <h1>Faire un don à {{ association.nom }}</h1>
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="form-group row">
                    {{ form_label(form.montant, 'Montant', {'label_attr': {'class': 'col-sm-4 col-form-label form-label'}}) }}
                    <div class="col-sm-8">
                        {{ form_widget(form.montant, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.montant) }}
                    </div>
                </div>
                <div class="form-group row">
                </div>
                <div class="form-group row">
                    <div class="col-sm-12 text-center">
                        <button type="submit" class="btn btn-primary">Soumettre</button>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}