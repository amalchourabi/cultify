<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Confirmation de Don - Cultify</title>
    <style>
        /* Style général */
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 20px;
            background-color: rgb(204, 225, 228); /* Couleur de fond */
            color: #333;
        }

        /* Conteneur principal */
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        }

        /* En-tête */
        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header img {
            width: 150px; /* Taille du logo */
            margin-bottom: 20px;
        }

        .header h1 {
            color: rgb(149, 110, 73); /* Couleur du titre */
            font-size: 28px;
            margin: 0;
        }

        .header p {
            color: #777;
            font-size: 16px;
            margin: 5px 0 0;
        }

        /* Informations de l'utilisateur */
        .user-info {
            margin-bottom: 30px;
        }

        .user-info p {
            margin: 5px 0;
        }

        /* Tableau des dons */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 30px;
        }

        table th, table td {
            padding: 10px;
            border: 1px solid #ddd;
            text-align: left;
        }

        table th {
            background-color: rgb(149, 110, 73); /* Couleur de l'en-tête du tableau */
            color: #fff;
        }

        table tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        /* Total */
        .total {
            text-align: right;
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 30px;
            color: rgb(149, 110, 73); /* Couleur du total */
        }

        /* Pied de page */
        .footer {
            margin-top: 30px;
            text-align: center;
            color: #777;
            font-size: 14px;
        }

        .footer a {
            color: rgb(149, 110, 73); /* Couleur du lien */
            text-decoration: none;
        }

        .footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- En-tête avec logo -->
        <div class="header">
            <img src="{{ asset ('images/white-logo.png') }}" alt="Logo de MonSiteWeb">
            <h1>Confirmation de Don</h1>
            <p>Merci pour votre générosité !</p>
        </div>

        <!-- Informations de l'utilisateur -->
        <div class="user-info">
            <p><strong>Nom du donateur:</strong> {{ don.idUser.nom }}</p>
            <p><strong>Email:</strong> {{ don.idUser.email }}</p>
        </div>

        <!-- Tableau des dons -->
        <table>
            <thead>
                <tr>
                    <th>ID du Don</th>
                    <th>Association</th>
                    <th>Montant</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{ don.id }}</td>
                    <td>{{ don.association.nom }}</td>
                    <td>{{ don.montant }} €</td>
                    <td><p>{{ "now"|date() }} </p></td>
                </tr>
            </tbody>
        </table>

        <!-- Total -->
        <div class="total">
            <p><strong>Total:</strong> {{ don.montant }} €</p>
        </div>

        <!-- Pied de page -->
        <div class="footer">
            <p>Pour toute question, contactez-nous à <a href="mailto:support@cultify.com">support@cultify.com</a>.</p>
            <p>{{ "now"|date("Y") }} Cultify. Tous droits réservés.</p>
        </div>
    </div>
</body>
</html>