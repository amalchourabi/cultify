<style>
    body {
        padding-top: 120px; /* Ajustez selon la hauteur réelle de votre header */
    }
</style>

    <main class="main-content">
        <!-- Votre contenu principal ici -->
    </main>

    <script>
        const header = document.getElementById('header');
        let lastScrollTop = 0;

        window.addEventListener('scroll', () => {
            const currentScrollTop = window.pageYOffset || document.documentElement.scrollTop;

            if (currentScrollTop > lastScrollTop && currentScrollTop > 100) {
                header.classList.add('scrolled');
            } else if (currentScrollTop < lastScrollTop) {
                header.classList.remove('scrolled');
            }

            lastScrollTop = currentScrollTop <= 0 ? 0 : currentScrollTop;
        });
    </script>
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="h3">Liste des associations ({{ pager.nbResults }})</h1>
            </div>
        </div>
    </div>

    {# Barre de recherche #}
    <div class="row mb-4">
        <div class="col">
            <input type="text" id="searchInput" class="form-control" placeholder="Rechercher une association...">
        </div>
    </div>

    {# Conteneur pour les résultats #}
<div class="row" id="associationsContainer">
            {% for association in pager.currentPageResults %}
                {% set progression = association.pourcentageProgression|default(0) %}
                <div class="col-md-4 mb-4">
                    <a href="{{ path('app_don_new', {'id': association.id}) }}" style="text-decoration: none;">
                        <div class="card">
                            {% if association.image %}
                                <div class="card-image" style="background-image: url('{{ asset('uploads/images/' ~ association.image) }}');"></div>
                            {% else %}
                                <div class="card-image">
                                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M20 5H4V19L13.2923 9.70649C13.6828 9.31595 14.3159 9.31591 14.7065 9.70641L20 15.0104V5ZM2 3.9934C2 3.44476 2.45531 3 2.9918 3H21.0082C21.556 3 22 3.44495 22 3.9934V20.0066C22 20.5552 21.5447 21 21.0082 21H2.9918C2.44405 21 2 20.5551 2 20.0066V3.9934ZM8 11C6.89543 11 6 10.1046 6 9C6 7.89543 6.89543 7 8 7C9.10457 7 10 7.89543 10 9C10 10.1046 9.10457 11 8 11Z"></path>
                                    </svg>
                                </div>
                            {% endif %}
                            
                            {# Barre de progression toujours affichée, avec style ajusté #}
                            <div class="progress-container">
                                <div class="progress">
                                    {% set progressClass = 
                                        progression <= 25 ? 'progress-bar-danger' : 
                                        progression <= 50 ? 'progress-bar-warning' : 
                                        progression <= 75 ? 'progress-bar-info' : 
                                        'progress-bar-success' 
                                    %}
                                    <div class="progress-bar {{ progressClass }}" 
                                         role="progressbar" 
                                         style="width: {{ progression }}%;" 
                                         aria-valuenow="{{ progression }}" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                        {{ progression|number_format(1) }}%
                                    </div>
                                </div>
                            </div>
                            
                            <div class="card__content" onclick="event.stopPropagation()">
                                <p class="card__title">{{ association.nom|upper }}</p>
                                <div class="card__description">
                                    <p><strong>Description :</strong> {{ association.description }}</p>
                                    <p><strong>Contact :</strong> {{ association.contact }}</p>
                                    <p><strong>But :</strong> {{ association.but }}</p>
                                    <p><strong>Objectif :</strong> {{ association.montantDesire|number_format(2, ',', ' ') }} TND</p>
                                    {% if association.siteWeb %}
                                        <div class="qr-code-container">
                                            <img src="{{ path('app_association_qrcode', {'id': association.id}) }}" alt="QR Code">
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>

{# Pagination #}
<div class="d-flex justify-content-center">
    {{ pagerfanta(pager, 'twitter_bootstrap5') }}
</div>
{% endblock %}

{% block js %}
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('searchInput').addEventListener('input', function () {
            const searchTerm = this.value;
            fetch(`/associationsUser/search?search=${encodeURIComponent(searchTerm)}`)
                .then(response => response.json())
                .then(data => {
                    const container = document.getElementById('associationsContainer');
                    container.innerHTML = ''; // Effacer les résultats précédents

                    data.forEach(association => {
                        // Déterminer la classe de couleur en fonction du pourcentage
                        const progression = association.pourcentageProgression || 0;
                        let progressClass = '';
                        if (progression <= 25) {
                            progressClass = 'progress-bar-danger';
                        } else if (progression <= 50) {
                            progressClass = 'progress-bar-warning';
                        } else if (progression <= 75) {
                            progressClass = 'progress-bar-info';
                        } else {
                            progressClass = 'progress-bar-success';
                        }

                        // Construire le chemin vers l'image en utilisant le même format que dans Twig
                        const qrCodeHtml = association.siteWeb ? 
                            `<div class="qr-code-container">
                                <img src="${association.qrCodeUrl}" alt="QR Code">
                            </div>` : '';

                        const imageUrl = association.image ? 
                            `/uploads/images/${association.image}` : '';

                        // Condition pour afficher ou non la barre de progression
                        const progressBarHtml = progression < 100 ?
                            `<div class="progress-container">
                                <div class="progress">
                                    <div class="progress-bar ${progressClass}" 
                                         role="progressbar" 
                                         style="width: ${progression}%;" 
                                         aria-valuenow="${progression}" 
                                         aria-valuemin="0" 
                                         aria-valuemax="100">
                                        ${progression.toFixed(1)}%
                                    </div>
                                </div>
                            </div>` : '';

                        const card = `
                            <div class="col-md-4 mb-4">
                                <a href="/don/new/${association.id}" style="text-decoration: none;">
                                    <div class="card">
                                        ${association.image ?
                                            `<div class="card-image" style="background-image: url('${imageUrl}');"></div>` :
                                            `<div class="card-image">
                                                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M20 5H4V19L13.2923 9.70649C13.6828 9.31595 14.3159 9.31591 14.7065 9.70641L20 15.0104V5ZM2 3.9934C2 3.44476 2.45531 3 2.9918 3H21.0082C21.556 3 22 3.44495 22 3.9934V20.0066C22 20.5552 21.5447 21 21.0082 21H2.9918C2.44405 21 2 20.5551 2 20.0066V3.9934ZM8 11C6.89543 11 6 10.1046 6 9C6 7.89543 6.89543 7 8 7C9.10457 7 10 7.89543 10 9C10 10.1046 9.10457 11 8 11Z"></path>
                                                </svg>
                                            </div>`
                                        }
                                        
                                        ${progressBarHtml}
                                        
                                        <div class="card__content" onclick="event.stopPropagation()">
                                            <p class="card__title">${association.nom.toUpperCase()}</p>
                                            <div class="card__description">
                                                <p><strong>Description :</strong> ${association.description}</p>
                                                <p><strong>Contact :</strong> ${association.contact}</p>
                                                <p><strong>But :</strong> ${association.but}</p>
                                                <p><strong>Objectif :</strong> ${association.montantDesire ? Number(association.montantDesire).toLocaleString('fr-FR', {minimumFractionDigits: 2, maximumFractionDigits: 2}).replace('.', ',') : 'N/A'} TND</p>
                                                ${qrCodeHtml}
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            </div>
                        `;
                        container.innerHTML += card;
                    });
                })
                .catch(error => console.error('Erreur lors de la recherche :', error));
        });
    </script>
{% endblock %}