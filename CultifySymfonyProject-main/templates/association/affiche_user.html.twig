    <style>
        /* Vos styles personnalisés ici */
        
        .card {
          position: relative;
          width: 300px;
          height: 200px;
          background: linear-gradient(-45deg, #f89b29 0%, #ff0f7b 100% );
          border-radius: 10px;
          display: flex;
          align-items: center;
          justify-content: center;
          overflow: visible;
          transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
          margin-bottom: 20px;
          cursor: pointer; /* Ajoute un curseur pointeur pour indiquer que c'est cliquable */
        }

        .card-image {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
          z-index: 1;
          border-radius: 10px;
        }

        .card svg {
          width: 48px;
          fill: #333;
          transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
        }

        .card:hover {
          transform: rotate(-5deg) scale(1.05);
          box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
          z-index: 100;
        }

        .card__content {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%; /* Même taille que l'image */
          padding: 10px;
          box-sizing: border-box;
          background-color: #fff;
          opacity: 0;
          transform: rotate(-45deg);
          transition: all 0.6s cubic-bezier(0.23, 1, 0.320, 1);
          z-index: 2;
          border-radius: 10px;
          max-height: 200px; /* Même hauteur que la carte */
          overflow-y: auto; /* Permet de scroller */
        }

        .card:hover .card__content {
          transform: rotate(0deg);
          opacity: 1;
          overflow-y: auto;
          box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        }

        /* Masquer la barre de progression quand on survole la carte */
        .card:hover .progress-container {
          display: none;
        }

        .card__title {
          margin: 0 0 5px 0;
          font-size: 16px;
          color: #333;
          font-weight: 700;
          text-align: center;
          border-bottom: 1px solid #eee;
          padding-bottom: 5px;
        }

        .card__description {
          margin: 5px 0;
          font-size: 11px;
          color: #777;
          line-height: 1.2;
        }

        .card__description p {
          margin-bottom: 4px;
        }
        
        .card__description strong {
          font-size: 11px;
        }

        .card:hover svg {
          scale: 0;
          transform: rotate(-45deg);
        }
        
        /* QR code plus petit */
        .qr-code-container {
          text-align: center;
          margin: 3px 0;
        }
        
        .qr-code-container img {
          width: 35px;
          height: auto;
        }
        
        /* Style pour les liens */
        .card__description a {
          font-size: 10px;
          word-break: break-all;
        }
        
        /* Barre de progression sur la photo uniquement (et transparente) */
        .progress-container {
          position: absolute;
          bottom: 10px;
          left: 10px;
          right: 10px;
          z-index: 3;
        }
        
        .progress {
          height: 10px !important;
          background-color: rgba(255, 255, 255, 0.3) !important; /* Plus transparent */
        }
        
        /* Couleurs pour les différents niveaux de progression */
        .progress-bar-danger {
          background-color: rgba(220, 53, 69, 0.7) !important; /* Rouge pour 0-25% */
        }
        
        .progress-bar-warning {
          background-color: rgba(255, 193, 7, 0.7) !important; /* Jaune pour 25-50% */
        }
        
        .progress-bar-info {
          background-color: rgba(13, 202, 240, 0.7) !important; /* Bleu clair pour 50-75% */
        }
        
        .progress-bar-success {
          background-color: rgba(25, 135, 84, 0.7) !important; /* Vert pour 75-100% */
        }
        
        /* Pour s'assurer que tout est affiché quand on survole */
        #associationsContainer .col-md-4 {
          overflow: visible;
        }

        /* Style pour la barre de défilement */
        .card__content::-webkit-scrollbar {
          width: 5px;
        }
        
        .card__content::-webkit-scrollbar-track {
          background: #f1f1f1;
          border-radius: 10px;
        }
        
        .card__content::-webkit-scrollbar-thumb {
          background: #888;
          border-radius: 10px;
        }
        
        .card__content::-webkit-scrollbar-thumb:hover {
          background: #555;
        }
    </style>
{% endblock %}

{% block body %}
